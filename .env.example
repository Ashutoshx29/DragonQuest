# Supabase (Phase 6 — cloud sync)
# Copy to .env.local and fill from Supabase Dashboard → Project Settings → API.
# Both values are PUBLIC by design: row level security protects the data.
# Without these, the app runs fully local (exact Phase 5 behavior).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
